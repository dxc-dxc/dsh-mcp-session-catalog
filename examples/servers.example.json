{
  "inactiveTurnsThreshold": 20,
  "servers": [
    {
      "serverName": "general-helper",
      "purpose": "独立 stdio 服务样例，沿用全局 20 轮回收阈值",
      "transport": "stdio",
      "command": "node",
      "args": ["/path/to/helper.mjs"],
      "sharing": "shared"
    },
    {
      "serverName": "heavy-service",
      "purpose": "独立重型服务样例，覆盖为连续 5 轮未用时回收",
      "transport": "stdio",
      "command": "node",
      "args": ["/path/to/heavy-service.mjs"],
      "sharing": "shared",
      "inactiveTurnsThreshold": 5
    }
  ]
}
