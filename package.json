{
  "name": "@dxc-dxc/dsh-mcp-session-catalog",
  "version": "2.6.0",
  "type": "module",
  "license": "MIT",
  "author": "dxc-dxc",
  "homepage": "https://github.com/dxc-dxc",
  "scripts": {
    "test": "node test/run.mjs"
  },
  "description": "Session-scoped MCP services and on-demand skill loading through the official DSH skill registry",
  "exports": {
    ".": "./index.mjs",
    "./v2_4": "./runtime-v2.4.mjs",
    "./v2_4/locale/*.json": "./locale/*.json",
    "./v2_4/icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./v2_5": "./runtime-v2.5.mjs",
    "./v2_5/locale/*.json": "./locale/*.json",
    "./v2_5/icon": "./icon.svg",
    "./skill-loader": "./skill-loader.mjs",
    "./skill-loader/locale/*.json": "./skill-locale/*.json",
    "./skill-loader/icon": "./icon.svg",
    "./hub-gate": "./hub-gate.mjs",
    "./hub-gate/locale/*.json": "./locale/*.json",
    "./hub-gate/icon": "./icon.svg"
  },
  "files": [
    "index.mjs",
    "pool.mjs",
    "http-connection.mjs",
    "hub-adapter.mjs",
    "hub-gate.mjs",
    "hub-ownership.mjs",
    "skill-loader.mjs",
    "skill-locale/*.json",
    "runtime-v2.5.mjs",
    "runtime-v2.4.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.md",
    "CHANGELOG.md",
    "examples/*",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.2.2 || 0.2.2-rc.1 || 0.2.2-rc.2"
  },
  "os": [
    "darwin"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0"
  }
}
